# ───────── Site ─────────
NEXT_PUBLIC_SITE_URL=https://www.dangalgym.com

# ───────── Supabase (Database, Auth, Storage) ─────────
# Leave blank to run the public site in DEMO MODE using built-in sample content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used by server actions after role checks.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Admin security ─────────
# Require TOTP 2FA for every admin/staff login (strongly recommended: true).
ADMIN_REQUIRE_2FA=true
# Max upload size for gym videos in MB (also set the same limit on the Supabase bucket).
NEXT_PUBLIC_MAX_VIDEO_MB=100

# ───────── Enquiry notifications ─────────
OWNER_EMAIL=support@dangalgym.com
# Email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Dangal Gym <noreply@dangalgym.com>"
# WhatsApp Cloud API (Meta). Owner number in international format, digits only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP=919676443944
# Optional approved template (needed for messages outside the 24h window). Body takes 3 params: name, phone, interest.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ───────── Spam protection ─────────
# Cloudflare Turnstile (optional but recommended). Honeypot + time-trap + rate limit always run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional distributed rate limiting (Upstash Redis REST). Falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────── Integrations ─────────
# Instagram Graph API long-lived token (optional; shows a styled fallback grid if blank)
INSTAGRAM_ACCESS_TOKEN=
NEXT_PUBLIC_GA_ID=
